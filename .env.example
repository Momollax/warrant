SCENARIO_EXIT_SPREAD_MULTIPLIER=1.5
SCENARIO_EXIT_SPREAD_DELTA_PENALTY=0.75
SCENARIO_STALE_PRICING_GUARD=1
SCENARIO_PARIS_HOUR=
SCENARIO_DIVIDENDS=

ORATS_API_KEY=orats_key_1,orats_key_2
POLYGON_API_KEY=polygon_key_1,polygon_key_2

# Gemini LLM audit in scenario TUI.
# Recommended high-quality model: gemini-3-pro-preview.
# More stable fallback: gemini-2.5-pro. Faster/cheaper: gemini-2.5-flash.
LLM_ENABLE=0
GEMINI_API_KEY=gemini_key_1,gemini_key_2
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_CACHE=1
LLM_CACHE_DIR=data/cache/llm
