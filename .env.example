# Profiles: custom, trade_republic, bourse_direct_500, bourse_direct_1000,
# bourse_direct_2000, bourse_direct_pct, bourse_direct_morgan_stanley,
# degiro_fr_actions, degiro_otc_sg_bnp, fortuneo_starter,
# fortuneo_starter_first_500.
BROKER_FEE_PROFILE=custom
FEE_ORDER_NOTIONAL=1000
